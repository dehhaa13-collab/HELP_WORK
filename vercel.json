{
  "rewrites": [
    { "source": "/api/supabase/(.*)", "destination": "https://egduscijdjjnxlxphfoe.supabase.co/$1" },
    { "source": "/((?!assets|favicon|manifest|icons|api).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
